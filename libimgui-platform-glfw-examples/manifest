: 1
name: libimgui-platform-glfw-examples
version: 1.92.9-a.0.z
upstream-version: 1.92.9b-docking
type: exe
language: c++
language: objective-c++=impl
project: imgui
topics: glfw
keywords: input windowing
summary: Dear ImGui platform backend for GLFW, docking branch (examples)
license: MIT
description-file: README.md
package-description-file: PACKAGE-README.md
changes-file: CHANGELOG.txt
url: https://github.com/ocornut/imgui
doc-url: https://github.com/ocornut/imgui/wiki
src-url: https://github.com/ocornut/imgui
email: contact@dearimgui.com
package-url: https://github.com/build2-packaging/imgui
package-email: packaging@build2.org ; Mailing list.
depends: * build2 >= 0.18.0
depends: * bpkg >= 0.18.0
depends: libimgui-render-opengl3 == $
depends: libimgui-render-vulkan == $
depends: libimgui-render-metal == $ ? ($cxx.target.class == 'macos')
depends:
\
glfw ^3.4.0
{
  prefer
  {
    config.glfw.build_x11 = ($cxx.target.class == 'linux' || $cxx.target.class == 'bsd')
  }

  accept ($config.glfw.build_x11 == ($cxx.target.class == 'linux' || $cxx.target.class == 'bsd'))
}
\
depends: libmoltenvk ^1.4.2 ? ($cxx.target.class == 'macos')

requires: c++20
requires: clang ? ($cxx.target.class == 'macos')

build-exclude: freebsd** ; Requires X11 dev headers.
build-exclude: **fedora** ; Requires X11 dev headers.
build-exclude: macos*-gcc** ; Requires Clang (libmoltenvk/libmetal-cpp).
build-exclude: windows**-static** ; Requires shared (libvulkan-loader).
