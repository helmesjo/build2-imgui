./: {*/ -build/ -metal/} doc{README.md PACKAGE-README.md CHANGELOG.txt} legal{LICENSE.txt} manifest

# The metal example needs a real GLFW-created Cocoa window bridged to a
# CAMetalLayer, so it only makes sense on macOS.
#
./: metal/: include = ($cxx.target.class == 'macos')

# The examples are for trying out the backends from the build directory,
# not for installing.
#
exe{*}: install = false
