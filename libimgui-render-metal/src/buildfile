intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libimgui%lib{imgui}

if ($cxx.target.class == 'macos')
  import intf_libs += libmetal-cpp%lib{metal-cpp}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{imgui-render-metal}: libul{imgui-render-metal}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
# This backend is macOS-only (Objective-C++); exclude the source on other
# platforms so the library builds (empty) instead of failing to compile.
#
libul{imgui-render-metal}: {hxx cxx}{**} $impl_libs $intf_libs
libul{imgui-render-metal}: mm{imgui_impl_metal}: include = ($cxx.target.class == 'macos')

# Use the metal-cpp (C++) API instead of the default Objective-C one, per
# libmetal-cpp above. Both the implementation and consumers of the public
# header need this defined identically. Only meaningful (and only safe to
# define) on macOS: that's the only platform where libmetal-cpp is actually
# a dependency (see intf_libs above), and imgui_impl_metal.h uses this macro
# to choose between the ObjC++ and metal-cpp API surfaces -- leaving it
# defined elsewhere would make any downstream consumer of the header try
# (and fail) to pull in <Metal/Metal.hpp>.
#
if ($cxx.target.class == 'macos')
{
  cxx.poptions += -DIMGUI_IMPL_METAL_CPP
  cxx.libs += -framework Metal -framework QuartzCore -framework Cocoa -framework Foundation
}

# Upstream's metal-cpp mode only builds without ARC, where it leaks (see
# imgui_impl_metal.mm.patch, which lets it build with ARC).
#
if ($cxx.target.class == 'macos')
  cxx.coptions += -fobjc-arc

libs{imgui-render-metal}: def{imgui-render-metal}: include = ($cxx.target.system == 'win32-msvc')
def{imgui-render-metal}: libul{imgui-render-metal}

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/
out_pfx_inc_unq = [dir_path] $out_root/include/imgui/
src_pfx_inc_unq = [dir_path] $src_root/include/imgui/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc" \
                "-I$out_pfx_inc_unq" "-I$src_pfx_inc_unq" \
                "-I$out_pfx_inc_unq/backends" "-I$src_pfx_inc_unq/backends"

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# Export options.
#
lib{imgui-render-metal}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" \
                        "-I$out_pfx_inc_unq" "-I$src_pfx_inc_unq" \
                        "-I$out_pfx_inc_unq/backends" "-I$src_pfx_inc_unq/backends"
  cxx.export.libs = $intf_libs
  cxx.pkgconfig.include = include/ include/imgui/ include/imgui/backends/
}

if ($cxx.target.class == 'macos')
{
  lib{imgui-render-metal}: cxx.export.poptions += -DIMGUI_IMPL_METAL_CPP
  lib{imgui-render-metal}: cxx.export.libs += -framework Metal -framework QuartzCore -framework Cocoa -framework Foundation
}

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{imgui-render-metal}: bin.lib.version = "-$version.project_id"
else
  lib{imgui-render-metal}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
hxx{*}: install = false
