intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libimgui%lib{imgui}

# No explicit link to the system OpenGL library: the bundled loader in
# imgui_impl_opengl3_loader.h resolves all GL entry points at runtime via
# dlopen()/dlsym() (GetProcAddress() on Windows). On older glibc, dlopen()
# itself lives in libdl rather than libc.
#
if ($cxx.target.class == 'linux')
  cxx.libs += -ldl

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{imgui-render-opengl3}: libul{imgui-render-opengl3}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
libul{imgui-render-opengl3}: {hxx cxx}{**} $impl_libs $intf_libs

libs{imgui-render-opengl3}: def{imgui-render-opengl3}: include = ($cxx.target.system == 'win32-msvc')
def{imgui-render-opengl3}: libul{imgui-render-opengl3}

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc"

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# Backend declarations (imgui_impl_opengl3.h) use IMGUI_IMPL_API, not
# IMGUI_API: imgui.h falls IMGUI_IMPL_API back to IMGUI_API only via
# #ifndef. Define IMGUI_IMPL_API directly for this backend's own exports;
# leave the inherited IMGUI_API=dllimport (from libimgui's export
# options, marking libimgui's own symbols) untouched.
#
if ($cxx.target.system == 'win32-msvc')
  objs{*}: cxx.coptions += '-DIMGUI_IMPL_API=__declspec(dllexport)'

# Export options.
#
lib{imgui-render-opengl3}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc"
  cxx.export.libs = $intf_libs
}

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{imgui-render-opengl3}: bin.lib.version = "-$version.project_id"
else
  lib{imgui-render-opengl3}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
hxx{*}: install = false
