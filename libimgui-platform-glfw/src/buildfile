intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

import intf_libs += libimgui%lib{imgui}
import impl_libs += glfw%lib{glfw}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{imgui-platform-glfw}: libul{imgui-platform-glfw}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
libul{imgui-platform-glfw}: {hxx cxx}{**} $impl_libs $intf_libs

libs{imgui-platform-glfw}: def{imgui-platform-glfw}: include = ($cxx.target.system == 'win32-msvc')
def{imgui-platform-glfw}: libul{imgui-platform-glfw}

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

cxx.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
                "-I$out_pfx_inc" "-I$src_pfx_inc" \
                "-I$out_pfx_inc/backends" "-I$src_pfx_inc/backends"

# GLFW's own glfw3.h pulls in <GL/gl.h> unless told not to; we use our own
# OpenGL loader (imgui_impl_opengl3_loader.h), so we never want it, and on
# some platforms (e.g. FreeBSD) that header isn't even present.
#
cxx.poptions += -DGLFW_INCLUDE_NONE

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# On MSVC the backend's own declarations (imgui_impl_glfw.h) use
# IMGUI_IMPL_API, which imgui.h only defaults to IMGUI_API if it is not
# already defined. Export them by defining it directly. The
# IMGUI_API=dllimport inherited from libimgui's export options keeps
# marking libimgui's own symbols.
#
if ($cxx.target.system == 'win32-msvc')
  objs{*}: cxx.poptions += '-DIMGUI_IMPL_API=__declspec(dllexport)'

# Export options.
#
lib{imgui-platform-glfw}:
{
  cxx.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc" \
                        "-I$out_pfx_inc/backends" "-I$src_pfx_inc/backends"
  cxx.export.libs = $intf_libs
  cxx.pkgconfig.include = include/ include/backends/
}

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{imgui-platform-glfw}: bin.lib.version = "-$version.project_id"
else
  lib{imgui-platform-glfw}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
hxx{*}: install = false
